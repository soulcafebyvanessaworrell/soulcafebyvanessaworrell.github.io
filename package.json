{
  "name": "soul-cafe",
  "version": "0.2.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Website for The Soul Cafe by Vanessa Worrell.",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "astro dev stop; ASTRO_DEV_BACKGROUND=1 astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "test:e2e": "playwright test",
    "lighthouse": "bun run scripts/lighthouse.mts",
    "ci": "bun run typecheck && bun run lint && I18N_REQUIRE_TRANSLATED=1 bun test && bun run build && CI=1 bun run test:e2e",
    "prepare": "husky"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@biomejs/biome": "^2.5.14",
    "@fontsource-variable/dancing-script": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-gujarati": "^5.3.0",
    "@fontsource/noto-sans-gurmukhi": "^5.3.0",
    "@fontsource/noto-sans-kannada": "^5.3.0",
    "@fontsource/noto-sans-malayalam": "^5.3.0",
    "@fontsource/noto-sans-ol-chiki": "^5.3.0",
    "@fontsource/noto-sans-oriya": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@fontsource/noto-sans-telugu": "^5.3.0",
    "@fontsource/pt-sans": "^5.3.0",
    "@iconify-json/lucide": "^1.2.135",
    "@iconify-json/simple-icons": "^1.2.97",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "astro": "^7.3.3",
    "astro-icon": "^1.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "sharp": "^0.35.4",
    "tailwindcss": "~4.3.3",
    "typescript": "6"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,astro}": "biome check --write"
  }
}
