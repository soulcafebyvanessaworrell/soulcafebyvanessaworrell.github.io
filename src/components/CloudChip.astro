---
// White pill for the approaches band; the drifting animation below supplies the "cloud" feel.
interface Props {
  class?: string;
}

const { class: klass = "" } = Astro.props;
---

<li
  class:list={[
    "cloud-chip inline-flex items-center justify-center rounded-full bg-paper px-7 py-4 text-center text-base font-bold leading-snug text-ink shadow-[var(--shadow-card)]",
    klass,
  ]}
>
  <slot />
</li>

<style>
  /* Each chip wanders a loose loop (sideways as well as up and down) so the
     band reads as clouds drifting across a sky. Different durations and
     negative delays per chip keep them out of sync. */
  .cloud-chip {
    animation: cloud-float 6.5s ease-in-out infinite;
    will-change: transform;
  }

  @keyframes cloud-float {
    0% {
      transform: translate(-14px, -10px) rotate(-0.8deg);
    }
    25% {
      transform: translate(6px, 6px) rotate(0.4deg);
    }
    50% {
      transform: translate(16px, -6px) rotate(0.8deg);
    }
    75% {
      transform: translate(-4px, 12px) rotate(-0.4deg);
    }
    100% {
      transform: translate(-14px, -10px) rotate(-0.8deg);
    }
  }

  .cloud-chip:nth-child(1) {
    animation-duration: 5.5s;
    animation-delay: -0.5s;
  }
  .cloud-chip:nth-child(2) {
    animation-duration: 7.5s;
    animation-delay: -2.4s;
  }
  .cloud-chip:nth-child(3) {
    animation-duration: 7s;
    animation-delay: -1.2s;
  }
  .cloud-chip:nth-child(4) {
    animation-duration: 8s;
    animation-delay: -3.6s;
  }
  .cloud-chip:nth-child(5) {
    animation-duration: 6s;
    animation-delay: -0.9s;
  }
  .cloud-chip:nth-child(6) {
    animation-duration: 7.8s;
    animation-delay: -4.2s;
  }
  .cloud-chip:nth-child(7) {
    animation-duration: 6.5s;
    animation-delay: -2s;
  }
  .cloud-chip:nth-child(8) {
    animation-duration: 8s;
    animation-delay: -1.6s;
  }

  /* Stay put when the visitor prefers reduced motion. */
  @media (prefers-reduced-motion: reduce) {
    .cloud-chip {
      animation: none;
      transform: none;
    }
  }
</style>
