---
// Site header on a mint band: one brand row, a hairline, one action bar. Each
// piece renders once and CSS lays it out per breakpoint, so the page carries
// one logo, one language picker, one nav landmark, and one of each pill.
//
// Desktop (lg+): the brand row centres the logo and the "Healing brewed
// daily..." tagline between two quiet ghost pills, Home at the inline start
// and the language picker at the inline end. The logo is a home link too; the
// Home pill is there so the start edge balances the picker (the owner's
// requirement). There is no cart until merch opens.
//
// Below a hairline and a slightly deeper mint tint, the action bar. Its order
// is a fixed user requirement: the Book a Session primary, then the six cream
// nav pills (centred), then the Contact Us outline secondary at the inline end.
//
// Mobile (< lg): no hamburger. The same pieces stay permanently visible in a
// compact stack: the brand row (a smaller logo and the tagline centred, the
// two pills at the edges, shrunk below `sm` to 44px rounds, the house icon on
// one and the language code on the other), then Book a Session, the nav pills
// as a centred wrap, and Contact Us.
//
// Hierarchy throughout: Book a Session is the one loud indigo primary, Contact
// Us a quieter outline, the nav the soft cream family, the utilities whisper.
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import {
  LOCALES,
  localeMeta,
  localizePath,
  pagePathFromUrl,
  type SiteLocale,
} from "../i18n/locales";
import { t } from "../i18n/ui";
import { logo, teacupDoodle } from "../lib/assets";
import { BRAND } from "../lib/constants";
import type { NavId } from "../lib/nav";
import LanguagePicker from "./LanguagePicker.astro";
import NavPills from "./NavPills.astro";
import PillButton from "./PillButton.astro";

interface Props {
  active?: NavId;
  locale: SiteLocale;
  /** Forwarded to the language picker: the locales this page exists in, and
   *  where to send the others (see Base.astro). */
  available?: readonly SiteLocale[];
  fallbackPath?: string;
}

const { active, locale, available = LOCALES, fallbackPath = "" } = Astro.props;

const homeHref = localizePath("", locale);
// The home page passes no `active` (it has no nav pill), so the Home pill reads
// its own state off the URL: the locale-relative page path is empty on home.
const onHome = pagePathFromUrl(Astro.url) === "";

// The logo link's name leads with the brand, in the locale's transliteration
// where the table has one, and the Home pill beside it is the link named
// "Home". The English brand name is a Latin run, isolated wherever it appears.
const brandName = localeMeta(locale).brand?.[BRAND] ?? BRAND;
const brandDir = brandName === BRAND ? "ltr" : undefined;
const contactHref = localizePath("contact/", locale);
const bookHref = localizePath("book/", locale);

// The logo renders at 96px on phones, 120px from `sm`, and 192px from `lg`;
// the candidates cover each of the three at 1x and 2x so a phone never
// downloads the desktop file. The source is 500px, so nothing is upscaled.
const LOGO_WIDTHS = [96, 120, 192, 240, 384];
const LOGO_SIZES = "(min-width: 1024px) 12rem, (min-width: 640px) 7.5rem, 6rem";
---

<header class="bg-mint text-ink">
  {/* ---- Brand row --------------------------------------------------------
      The brand block centres on the row itself and the two controls are pinned
      to the inline edges, so neither one's width can push the logo off-centre.
      Centred with flex, not a translate: a transform would make the wrapper a
      stacking context and trap the open menu's z-index under page content. */}
  <div class="relative mx-auto flex max-w-7xl justify-center px-4 pt-2 pb-1.5 lg:px-6 lg:pt-4 lg:pb-3">
    {/* The Home pill comes first in the DOM, as it does on screen, so focus
        moves start to end across the row. It shares the picker summary's
        .pill-ghost look so the two read as one pair. */}
    <div class="absolute start-3 top-3.5 flex items-center lg:top-0 lg:bottom-0 lg:start-6">
      <a
        href={homeHref}
        aria-current={onHome ? "page" : undefined}
        class:list={["pill-ghost tap", onHome && "border-ink/15 bg-paper/80 text-ink"]}
      >
        <Icon name="lucide:house" class="h-4 w-4 shrink-0" aria-hidden="true" />
        <span class="sr-only sm:not-sr-only">{t(locale, "home")}</span>
      </a>
    </div>

    <a href={homeHref} class="flex flex-col items-center gap-0.5 text-center lg:gap-1">
      <span class="sr-only" dir={brandDir}>{brandName}</span>
      <Image
        src={logo}
        alt=""
        width={192}
        height={192}
        widths={LOGO_WIDTHS}
        sizes={LOGO_SIZES}
        class="h-24 w-24 rounded-full sm:h-30 sm:w-30 lg:h-48 lg:w-48"
        loading="eager"
      />
      <span
        class="flex items-center gap-1 font-script text-sm font-bold text-periwinkle-deep lg:gap-1.5 lg:text-xl"
      >
        {t(locale, "tagline")}
        <img
          src={teacupDoodle}
          alt=""
          aria-hidden="true"
          width="24"
          height="24"
          class="teacup-bob h-4 w-4 lg:h-6 lg:w-6"
        />
      </span>
    </a>

    <div class="absolute end-3 top-3.5 flex items-center lg:top-0 lg:bottom-0 lg:end-6">
      <LanguagePicker locale={locale} available={available} fallbackPath={fallbackPath} align="end" />
    </div>
  </div>

  {/* ---- Action bar ------------------------------------------------------- */}
  <div class="border-t border-ink/10 bg-mint-deep/25">
    <div
      class="mx-auto flex max-w-7xl flex-col items-center gap-2 px-4 pt-2 pb-2.5 lg:grid lg:grid-cols-[1fr_auto_1fr] lg:gap-4 lg:px-6 lg:py-2.5"
    >
      {/* The owner fixed this order; the file comment above spells it out. */}
      <div class="lg:justify-self-start">
        <PillButton href={bookHref} variant="indigo">{t(locale, "book_session")}</PillButton>
      </div>
      <div class="min-w-0">
        <NavPills active={active} locale={locale} />
      </div>
      <div class="lg:justify-self-end">
        <PillButton href={contactHref} variant="coral-outline">
          {t(locale, "contact_us")}
        </PillButton>
      </div>
    </div>
  </div>
</header>
