---
// Site header on a mint band: one brand row, a hairline, one action bar. Each
// piece renders once and CSS lays it out per breakpoint, so the page carries
// one logo, one language picker, one nav landmark, and one of each pill.
//
// Desktop (lg+): the brand row centres the logo and the "Healing brewed
// daily..." tagline, with two quiet ghost utilities at the inline end: the
// language picker, then the cart. Below a hairline and a slightly deeper mint
// tint, the action bar. Its order is a fixed user requirement: home icon, then
// the Book a Session primary, then the six cream nav pills (centred), then the
// Contact Us outline secondary at the inline end.
//
// Mobile (< lg): no hamburger. The same pieces stay permanently visible in a
// compact stack: a brand row (home icon at the start, a smaller logo and the
// tagline centred, language and cart at the end), then Book a Session, the nav
// pills as a centred wrap, and Contact Us. The home icon is the one piece that
// moves rows: it lives in the action bar and is pinned to the brand row's start
// corner on phones, so the header stays a single copy.
//
// Hierarchy throughout: Book a Session is the one loud indigo primary, Contact
// Us a quieter outline, the nav the soft cream family, the utilities whisper.
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { LOCALES, localizePath, type SiteLocale } from "../i18n/locales";
import { t } from "../i18n/ui";
import { logo, teacupDoodle } from "../lib/assets";
import type { NavId } from "../lib/nav";
import LanguagePicker from "./LanguagePicker.astro";
import NavPills from "./NavPills.astro";
import PillButton from "./PillButton.astro";

interface Props {
  active?: NavId;
  locale: SiteLocale;
  /** Forwarded to the language picker: the locales this page exists in, and
   *  where to send the others (see Base.astro). */
  available?: readonly SiteLocale[];
  fallbackPath?: string;
}

const { active, locale, available = LOCALES, fallbackPath = "" } = Astro.props;

const homeHref = localizePath("", locale);
const contactHref = localizePath("contact/", locale);
const bookHref = localizePath("book/", locale);
const merchHref = localizePath("merch/", locale);

// The logo renders at 120px below `lg` and 192px from `lg`; the candidates
// cover each at 1x and 2x so a phone never downloads the desktop file. The
// source is 500px, so nothing is upscaled.
const LOGO_WIDTHS = [120, 192, 240, 384];
const LOGO_SIZES = "(min-width: 1024px) 12rem, 7.5rem";

const ghostControl =
  "tap inline-flex h-11 w-11 items-center justify-center rounded-full border border-ink/10 bg-paper/45 text-ink/70 transition-colors hover:bg-paper/80 hover:text-ink lg:h-9 lg:w-9";
---

{/* The header is the home icon's containing block on phones: the brand row
    is its first child with nothing above it, so the icon's top-start offsets
    land in the brand row's corner, level with the picker. No z-index, so the
    open language panel is not trapped. */}
<header class="relative bg-mint text-ink">
  {/* ---- Brand row --------------------------------------------------------
      The brand block centres on the row itself and the picker is pinned to the
      inline end, so its width cannot push the logo off-centre. Centred with
      flex, not a translate: a transform would make the wrapper a stacking
      context and trap the open menu's z-index under page content. */}
  <div class="relative mx-auto flex max-w-7xl justify-center px-4 pt-2.5 pb-2 lg:px-6 lg:pt-4 lg:pb-3">
    <a href={homeHref} class="flex flex-col items-center gap-0.5 text-center lg:gap-1">
      <span class="sr-only">{t(locale, "home")}</span>
      <Image
        src={logo}
        alt=""
        width={192}
        height={192}
        widths={LOGO_WIDTHS}
        sizes={LOGO_SIZES}
        class="h-30 w-30 rounded-full lg:h-48 lg:w-48"
        loading="eager"
      />
      <span
        class="flex items-center gap-1 font-script text-sm font-bold text-periwinkle-deep lg:gap-1.5 lg:text-xl"
      >
        {t(locale, "tagline")}
        <img
          src={teacupDoodle}
          alt=""
          aria-hidden="true"
          width="24"
          height="24"
          class="teacup-bob h-4 w-4 lg:h-6 lg:w-6"
        />
      </span>
    </a>

    {/* On phones the controls align with the logo row, above the tagline; on
        desktop they centre on the whole row. The cart hides on the narrowest
        phones, where the logo would otherwise meet the fixed 44px language
        trigger; merch stays one nav pill away. */}
    <div class="absolute end-3 top-3.5 flex items-center gap-1.5 lg:top-0 lg:bottom-0 lg:end-6">
      <LanguagePicker
        locale={locale}
        available={available}
        fallbackPath={fallbackPath}
        align="end"
      />
      <a
        href={merchHref}
        class:list={[ghostControl, "max-[360px]:hidden"]}
        aria-label={t(locale, "cart")}
      >
        <Icon name="lucide:shopping-cart" class="h-[1.15rem] w-[1.15rem]" aria-hidden="true" />
      </a>
    </div>
  </div>

  {/* ---- Action bar ------------------------------------------------------- */}
  <div class="border-t border-ink/10 bg-mint-deep/25">
    <div
      class="mx-auto flex max-w-7xl flex-col items-center gap-3 px-4 pt-3 pb-4 lg:grid lg:grid-cols-[1fr_auto_1fr] lg:gap-4 lg:px-6 lg:py-2.5"
    >
      {/* The owner fixed this order; the file comment above spells it out. */}
      <div class="flex items-center gap-2.5 lg:justify-self-start">
        {/* `lg:relative`, not static: `.tap` positions its 44px hit area
            against the control itself, and a static control would let it
            drift to the header. */}
        <a
          href={homeHref}
          class:list={[
            ghostControl,
            "absolute top-3.5 start-3 lg:relative lg:top-auto lg:start-auto",
          ]}
          aria-label={t(locale, "home")}
        >
          <Icon name="lucide:house" class="h-[1.15rem] w-[1.15rem]" aria-hidden="true" />
        </a>
        <PillButton href={bookHref} variant="indigo">{t(locale, "book_session")}</PillButton>
      </div>
      <div class="min-w-0">
        <NavPills active={active} locale={locale} />
      </div>
      <div class="flex items-center gap-2.5 lg:justify-self-end">
        <PillButton href={contactHref} variant="coral-outline">
          {t(locale, "contact_us")}
        </PillButton>
      </div>
    </div>
  </div>
</header>
