---
// Single 404 for the whole site (Astro serves one). GitHub Pages returns it for
// unmatched paths in every locale tree and there is no locale at build time, so
// the page ships English plus a pill for every language's home, and a small
// inline script turns the whole page, chrome included, to a locale: the failed
// URL's prefix when it has one, else the language the picker remembered, else
// the browser's. With JS off, English and the list remain. noindex so crawlers
// don't list it.
//
// The header and footer render English at build, so the script translates
// them by text: every chrome string it knows, matched by its English wording,
// swapped for the locale's. The crisis note alone is refilled from its
// template around the tel: links the footer marks with data-crisis. That
// keeps the page independent of how the chrome components are marked up,
// those two hooks aside; the JSON payload below is what it knows.
import PillButton from "../components/PillButton.astro";
import ScriptHeading from "../components/ScriptHeading.astro";
import type { UiKey } from "../i18n/en";
import { LANGUAGE_STORAGE_KEY } from "../i18n/languageStorage";
import {
  DEFAULT_LOCALE,
  LOCALE_TABLE,
  localePrefix,
  localizePath,
  type SiteLocale,
} from "../i18n/locales";
import { dictionaries, t } from "../i18n/ui";
import Base from "../layouts/Base.astro";

const en = DEFAULT_LOCALE;

// ui strings the payload leaves out: those no element of this page renders as
// a whole text node, and those with placeholders. The crisis note is the one
// placeholder string kept, whole: the client fills its template around the
// footer's marked tel: links.
const LEFT_OUT_OF_PAYLOAD: readonly UiKey[] = [
  "coming_soon",
  "coming_soon_body",
  "free_consultation",
  "founder_role",
  "version",
  "version_production",
];

/** Every chrome string of a locale, keyed so the client can pair each English
 *  wording with its translation. */
function chromeStrings(locale: SiteLocale): Record<string, string> {
  const { ui, pages } = dictionaries[locale];
  const strings: Record<string, string> = {};
  for (const key of Object.keys(ui) as UiKey[]) {
    if (!LEFT_OUT_OF_PAYLOAD.includes(key)) strings[key] = ui[key];
  }
  strings.privacy_title = pages.privacy.meta.title;
  return strings;
}

// The client pairs strings by their English wording, so two keys with the same
// English text would translate ambiguously. Caught here, at build.
const englishStrings = Object.values(chromeStrings(en)).map((s) => s.trim());
if (new Set(englishStrings).size !== englishStrings.length) {
  throw new Error("404.astro: two chrome strings share their English wording");
}

const payload = {
  base: import.meta.env.BASE_URL,
  defaultLocale: en,
  storageKey: LANGUAGE_STORAGE_KEY,
  locales: Object.fromEntries(
    LOCALE_TABLE.map((row) => [
      row.code,
      {
        lang: row.htmlLang,
        dir: row.dir,
        script: row.script,
        label: row.label,
        prefix: localePrefix(row.code),
        strings: chromeStrings(row.code),
      },
    ]),
  ),
};
---

<Base title={t(en, "not_found_title")} description={t(en, "not_found_body")} noindex available={[]}>
  <section class="mx-auto flex max-w-2xl flex-col items-center gap-6 px-5 py-24 text-center sm:py-32">
    <p class="font-script text-6xl font-bold text-ink">404</p>
    <ScriptHeading level={1}>{t(en, "not_found_title")}</ScriptHeading>
    <p class="max-w-lg text-lg leading-relaxed text-soft">{t(en, "not_found_body")}</p>
    <div class="mt-2 flex flex-wrap items-center justify-center gap-3">
      <PillButton href={localizePath("", en)} variant="indigo">{t(en, "back_home")}</PillButton>
      <PillButton href={localizePath("contact/", en)} variant="cream">{t(en, "contact_us")}</PillButton>
    </div>

    {/* Every language's home. The script leaves these links alone. */}
    <ul
      class="mt-6 flex w-full max-w-xl list-none flex-wrap items-center justify-center gap-2 border-t border-ink/10 pt-6"
      data-language-homes
    >
      {
        LOCALE_TABLE.map((row) => (
          <li>
            <a
              href={localizePath("", row.code)}
              hreflang={row.htmlLang}
              lang={row.htmlLang}
              dir={row.dir}
              class="tap inline-flex min-h-[2.25rem] items-center rounded-full border border-ink/10 bg-cream/70 px-3.5 py-1 text-sm font-bold text-ink transition-colors hover:bg-cream"
            >
              {row.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <script
    type="application/json"
    id="not-found-locales"
    set:html={JSON.stringify(payload).replace(/</g, "\\u003c")}
    is:inline
  />
  {/* data-astro-rerun: the ClientRouter otherwise runs an inline script once
      per session, and a soft navigation back into the 404 would stay English. */}
  <script is:inline data-astro-rerun>
    (() => {
      const raw = document.getElementById("not-found-locales");
      if (!raw) return;
      const { base, defaultLocale, storageKey, locales } = JSON.parse(raw.textContent || "{}");
      if (!locales) return;

      // 1. The locale prefix in the failed URL, if any.
      const path = location.pathname.startsWith(base) ? location.pathname.slice(base.length) : location.pathname;
      const first = path.replace(/^\//, "").split("/")[0];
      let code = Object.hasOwn(locales, first) ? first : "";

      // 2. Otherwise the language the picker remembered.
      if (!code) {
        try {
          const stored = localStorage.getItem(storageKey);
          if (stored && Object.hasOwn(locales, stored)) code = stored;
        } catch {}
      }

      // 3. Otherwise the browser's preferred languages, most preferred first.
      if (!code) {
        for (const tag of navigator.languages || []) {
          const lower = tag.toLowerCase();
          const match = Object.keys(locales).find(
            (c) => lower === locales[c].lang.toLowerCase() || lower.split("-")[0] === c,
          );
          if (match) {
            code = match;
            break;
          }
        }
      }
      if (!code || code === defaultLocale) return;

      const l = locales[code];
      const root = document.documentElement;
      root.setAttribute("lang", l.lang);
      root.setAttribute("dir", l.dir);
      root.setAttribute("data-script", l.script);

      // The footer and the WhatsApp float come after this script in the
      // document, so the chrome is translated once the whole page has parsed.
      const translateChrome = () => {
        const english = locales[defaultLocale].strings;
        const words = new Map();
        for (const key of Object.keys(english)) {
          const from = english[key].trim();
          if (from) words.set(from, l.strings[key].trim());
        }

        // Text nodes and labelling attributes: swap each English chrome string
        // for the locale's, keeping the whitespace around it.
        const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
        for (let node = walker.nextNode(); node; node = walker.nextNode()) {
          const text = node.nodeValue;
          const local = words.get(text.trim());
          if (local !== undefined) node.nodeValue = text.replace(text.trim(), () => local);
        }
        for (const el of document.body.querySelectorAll("[aria-label], [title]")) {
          for (const name of ["aria-label", "title"]) {
            const local = words.get(el.getAttribute(name));
            if (local !== undefined) el.setAttribute(name, local);
          }
        }

        // The crisis note: the locale's template, with each {name} placeholder
        // replaced by the footer's tel: link of that name (fill() on the
        // server does the same splice with strings), so no text is matched.
        for (const note of document.body.querySelectorAll("[data-crisis-note]")) {
          const links = new Map();
          for (const a of note.querySelectorAll("a[data-crisis]")) links.set(a.dataset.crisis, a);
          const parts = l.strings.crisis_note.split(/\{([a-z]+)\}/);
          note.replaceChildren(...parts.map((part, i) => (i % 2 ? (links.get(part) ?? `{${part}}`) : part)));
        }
        document.title = document.title.replace(english.not_found_title, () => l.strings.not_found_title);

        // Internal links move into the locale's tree, as localizePath would have
        // built them: base, then the locale prefix, then the page path. The
        // picker's and the language list's links already name their locale.
        for (const a of document.body.querySelectorAll("a[href]")) {
          if (a.closest("[data-language-picker], [data-language-homes]")) continue;
          const href = a.getAttribute("href");
          if (!href.startsWith(base)) continue;
          const rest = href.slice(base.length);
          if (Object.hasOwn(locales, rest.split("/")[0])) continue;
          a.setAttribute("href", base + l.prefix + rest);
        }

        // The picker's summary names the current language; its list marks it.
        for (const summary of document.querySelectorAll("[data-language-picker] summary")) {
          const endonym = summary.querySelector("span[lang]");
          if (endonym) {
            endonym.textContent = l.label;
            endonym.setAttribute("lang", l.lang);
          }
          const shortCode = summary.querySelector('span[dir="ltr"]');
          if (shortCode) shortCode.textContent = code;
        }
        for (const a of document.querySelectorAll("[data-language-picker] a[aria-current]")) {
          a.removeAttribute("aria-current");
        }
        for (const a of document.querySelectorAll(`[data-language-picker] a[data-locale="${code}"]`)) {
          a.setAttribute("aria-current", "page");
        }
      };
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", translateChrome, { once: true });
      } else {
        translateChrome();
      }
    })();
  </script>
</Base>
