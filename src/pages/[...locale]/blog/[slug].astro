---
// Blog post page. One static route per published post in every locale that
// has it: getStaticPaths groups all posts by slug so each page knows which
// locales carry a translation, and passes that as `available` so the language
// picker sends the others to the blog index instead of a 404. Body renders
// through @tailwindcss/typography, with the prose colors tuned to the ink palette.
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import ScriptHeading from "../../../components/ScriptHeading.astro";
import { localeMeta, localizePath } from "../../../i18n/locales";
import { localeParam } from "../../../i18n/routes";
import { blogUi } from "../../../i18n/ui";
import Base from "../../../layouts/Base.astro";
import { groupBySlug, isoDate } from "../../../lib/blog";

export async function getStaticPaths() {
  const all = await getCollection("blog", (p) => !p.data.draft);
  return Array.from(groupBySlug(all), ([slug, group]) => {
    const available = group.map((p) => p.data.locale);
    return group.map((post) => ({
      params: { locale: localeParam(post.data.locale), slug },
      props: { post, locale: post.data.locale, available },
    }));
  }).flat();
}

const { post, locale, available } = Astro.props;
const { Content } = await render(post);
const copy = blogUi(locale);

const dateFmt = new Intl.DateTimeFormat(localeMeta(locale).dateLocale, {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<Base
  title={post.data.title}
  description={post.data.description}
  active="blog"
  available={available}
  fallbackPath="blog/"
>
  <article class="mx-auto max-w-3xl px-5 py-16 sm:py-20">
    <a
      href={localizePath("blog/", locale)}
      class="tap inline-flex items-center gap-1.5 py-2 text-sm font-semibold text-ink/80 transition-colors hover:text-coral-bright"
    >
      <Icon name="lucide:arrow-left" class="h-4 w-4 rtl:-scale-x-100" aria-hidden="true" />
      {copy.back}
    </a>

    <ScriptHeading level={1} class="mt-6 text-center">{post.data.title}</ScriptHeading>
    <time datetime={isoDate(post.data.pubDate)} class="mt-3 block text-center text-sm text-soft">
      {dateFmt.format(post.data.pubDate)}
    </time>

    {
      post.data.heroImage && (
        <Image
          src={post.data.heroImage}
          alt={post.data.heroImageAlt ?? ""}
          class="mt-10 w-full rounded-3xl shadow-sm"
        />
      )
    }

    <div
      class="prose prose-lg mx-auto mt-10 max-w-2xl prose-headings:font-sans prose-headings:text-ink prose-p:text-ink/90 prose-a:font-semibold prose-a:text-periwinkle-deep prose-strong:text-ink prose-li:text-ink/90 prose-blockquote:border-coral prose-blockquote:text-soft"
    >
      <Content />
    </div>
  </article>
</Base>
